# Token de Thordata. Obligatorio.
# Sirve para dos cosas: como `Authorization: Bearer <token>` al lanzar tareas
# de scraping, y como cabecera `token` (sin Bearer) al descargar resultados.
THORDATA_TOKEN=

# Proveedor compatible con la API de OpenAI (embeddings + chat). Obligatorio.
# Base con /v1 incluido, p. ej. https://api.nan.builders/v1
AI_API_BASE_URL=
AI_API_KEY=

# Opcionales. Si se dejan vacíos se eligen por nombre desde GET {base}/models.
# CHAT_MODEL=
# EMBEDDING_MODEL=
# MAX_REQUESTS_PER_RUN=50
