# Token de Thordata (conseguir las transcripciones de YouTube sin bloqueos).
THORDATA_TOKEN=

# Proveedor compatible con la API de OpenAI (embeddings + chat).
# Base con /v1 incluido, p. ej. https://api.nan.builders/v1
AI_API_BASE_URL=
AI_API_KEY=

# Opcionales. Si se dejan vacíos se eligen por nombre desde GET {base}/models.
CHAT_MODEL=
EMBEDDING_MODEL=
MAX_REQUESTS_PER_RUN=50
